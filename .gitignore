# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
slides/
report/

# --- Virtual envs (project uses the `pic` conda env, outside the repo) ---
.venv/
venv/
env/

runs/

# --- PIC-A predecessor material (Anagha / Pranav): 353 MB of raw datasets and
#     one-off analysis scripts. Kept on disk, inventoried in Anagha/README.md,
#     deliberately out of git history. ---
Anagha/

# --- Vendor source material for the 6x6 (NUS): the whole-chip GDS, the Altium
#     daughter-board, picpin.drawio and the design decks. 30 MB of binaries that
#     nothing imports and that only ever get read by a human. Kept on disk, cited
#     from 6x6/Readme.md and 6x6/pic/wiring.py, deliberately out of git history. ---
6x6/NUS/

# --- AeroDiode vendor software: the Windows control-software installer (30 MB) and
#     the root-level driver it was reverse-engineered into. `pic/devices/pdmv5.py`
#     replaced both. Kept on disk, out of git history. Anchored: 6x6/laser/ is
#     the driver package and is tracked. ---
/laser/

# --- 6x6 manuscript, source and build products. The chip is archived and the paper
#     is written; it lives on disk, not in the tree. ---
6x6/paper/

# --- Mrunal's 4x4 bench material: datasheets, measurement reports and design decks.
#     23 MB of binaries nothing imports; read README.md, not the raw tree. Three
#     exceptions stay tracked -- the digest, the firmware, and the 28k sweep, which is
#     the training input for pic_data/surrogate/mrunal_28k. ---
4x4/mrunal/*
!4x4/mrunal/README.md
!4x4/mrunal/Setup.ino
!4x4/mrunal/tec_pid_1.ino
!4x4/mrunal/28k_Data_points .xlsx

# --- Ananya's PIC-A predecessor reports: 7 MB of PDFs, all narrative. ---
4x4/ananya/

# --- The source spreadsheet the 100k CSVs above were derived from. ---
100k_data_original.xlsx

# --- Generated figures. `./do figs` redraws the 4x4 set from the layout modules and
#     the live calibration, so a copy in the tree is only ever a stale copy. The
#     6x6 schematics are the exception: pic_structure*.png is the deliverable and is
#     tracked, even though pic_clean_schematic.py can redraw it. ---
4x4/figs/

# --- 6x6/Images: heatmaps and overview slides from the PIC-A era. Nothing in the
#     tree references them and the chip is archived. ---
6x6/Images/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Editors ---
.vscode/
.idea/
*.swp

# --- Regenerable data caches / derived files ---
# npz/npy caches (e.g. /tmp/pic_100k.npz, dac_pd_influence.npy) — rebuild from source
*.npz
*.npy
# CSVs derived from 100k_data_original.xlsx
100k_inputs.csv
100k_outputs.csv

# --- Optimizer run outputs (generated by the notebook / inverse solver) ---
best_input.txt
best_output.txt
optimization_summary.txt

# --- Claude Code local state ---
.claude/

# --- Schematic scratch: reference crops + verification renders (regenerable;
#     the deliverable is pic_structure.png at the repo root) ---
schematic_ref/
PIC.png
PIC_flipped.png

# --- Large raw experiment dumps (not derived artifacts; keep them out of git) ---
**/pic_data/testing_working_ps_hybrid_*.xlsx

# --- LaTeX build artifacts (the paper source and its images are tracked; the
#     intermediates are not) ---
**/paper/*.aux
**/paper/*.log
**/paper/*.blg
**/paper/*.bbl
**/paper/*.out
**/paper/*.xdv
**/paper/*.synctex.gz

# --- Long-running solver logs under theory/results (the .json results are tracked) ---
**/theory/results/*.log

# --- Agent config: kept on disk, deliberately out of git history ---
LEFT_OUT.md
CLAUDE.md
**/CLAUDE.md
AGENTS.md
**/AGENTS.md
.cursorrules
.cursor/
.github/copilot-instructions.md
.codex/
.gemini/
GEMINI.md
